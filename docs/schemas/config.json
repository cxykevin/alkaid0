{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "alkaid0 Config",
    "description": "alkaid0 配置文件",
    "type": "object",
    "required": [
        "Version",
        "Model",
        "Agent",
        "ThemeID",
        "Server"
    ],
    "properties": {
        "Version": {
            "type": "integer",
            "description": "配置版本号",
            "minimum": 1,
            "default": 1
        },
        "Model": {
            "type": "object",
            "description": "模型相关配置",
            "required": [
                "DefaultModelID",
                "Models"
            ],
            "properties": {
                "ProviderURL": {
                    "type": "string",
                    "description": "默认供应商URL（备用字段）",
                    "format": "uri"
                },
                "ProviderKey": {
                    "type": "string",
                    "description": "默认供应商密钥（备用字段）"
                },
                "DefaultModelID": {
                    "type": "integer",
                    "description": "默认使用的模型ID，对应 Models 中的键"
                },
                "Models": {
                    "type": "object",
                    "description": "模型定义集合，键为模型ID（整数字符串）",
                    "additionalProperties": {
                        "type": "object",
                        "required": [
                            "ModelName",
                            "ModelID"
                        ],
                        "properties": {
                            "ModelName": {
                                "type": "string",
                                "description": "模型显示名称",
                                "minLength": 1
                            },
                            "ModelID": {
                                "type": "string",
                                "description": "模型在供应商处的ID"
                            },
                            "ModelDescription": {
                                "type": "string",
                                "description": "模型描述",
                                "default": ""
                            },
                            "ModelAddPrompt": {
                                "type": "string",
                                "description": "附加的系统提示词",
                                "default": ""
                            },
                            "ModelTopP": {
                                "type": "number",
                                "description": "Top-P 采样参数，-1 代表使用供应商默认值",
                                "default": -1
                            },
                            "ModelTopK": {
                                "type": "number",
                                "description": "Top-K 采样参数，-1 代表使用供应商默认值",
                                "default": -1
                            },
                            "ModelTemperature": {
                                "type": "number",
                                "description": "温度参数，-1 代表使用供应商默认值",
                                "default": -1
                            },
                            "TokenLimit": {
                                "type": "integer",
                                "description": "单次请求最大 Token 数",
                                "minimum": 1,
                                "default": 8192
                            },
                            "ProviderURL": {
                                "type": "string",
                                "description": "模型供应商API地址（覆写全局值）",
                                "format": "uri"
                            },
                            "ProviderKey": {
                                "type": "string",
                                "description": "模型供应商API密钥（覆写全局值）"
                            },
                            "EnableThinking": {
                                "type": "boolean",
                                "description": "是否启用思考模式",
                                "default": false
                            },
                            "EnableToolCalling": {
                                "type": "boolean",
                                "description": "是否启用工具调用（只影响 delta 拼接）",
                                "default": false
                            },
                            "CompressSize": {
                                "type": "integer",
                                "description": "上下文压缩阈值（token数）",
                                "minimum": 0,
                                "default": 128000
                            },
                            "Hide": {
                                "type": "boolean",
                                "description": "是否在列表中隐藏",
                                "default": false
                            },
                            "Type": {
                                "type": "string",
                                "description": "模型类型：\"\"(LLM)、\"embedding\"、\"rerank\"",
                                "enum": [
                                    "",
                                    "embedding",
                                    "rerank"
                                ],
                                "default": ""
                            },
                            "ProviderSpecificConfig": {
                                "type": "object",
                                "description": "供应商特定功能开关（可选，省略时使用以下默认值）",
                                "properties": {
                                    "EnableDeepseekThinking": {
                                        "type": "boolean",
                                        "default": false
                                    },
                                    "EnableReasoningEffort": {
                                        "type": "boolean",
                                        "default": true
                                    },
                                    "EnableTopP": {
                                        "type": "boolean",
                                        "default": false
                                    },
                                    "EnableTopK": {
                                        "type": "boolean",
                                        "default": false
                                    },
                                    "EnableTemperature": {
                                        "type": "boolean",
                                        "default": false
                                    },
                                    "EnableUsage": {
                                        "type": "boolean",
                                        "default": true
                                    },
                                    "Dimension": {
                                        "type": "integer",
                                        "description": "嵌入模型向量维度（嵌入模型必填）",
                                        "minimum": 0,
                                        "default": 0
                                    },
                                    "ToolPromptEnhance": {
                                        "type": "string",
                                        "description": "工具调用反幻觉增强提示词开关：auto(默认,启用；模型id命中 gpt/sol/luna/terra/claude/fable/sonnet/haiku/opus 时自动免增强) / on(强制启用) / off(强制关闭)",
                                        "enum": ["auto", "on", "off"],
                                        "default": "auto"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "Agent": {
            "type": "object",
            "description": "Agent 系统配置",
            "properties": {
                "Agents": {
                    "type": "object",
                    "description": "Agent 定义集合",
                    "additionalProperties": {
                        "type": "object",
                        "required": [
                            "AgentName",
                            "AgentDescription",
                            "AgentPrompt",
                            "AgentModel"
                        ],
                        "properties": {
                            "Color": {
                                "type": "object",
                                "description": "Agent 颜色（RGB）",
                                "properties": {
                                    "Red": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 255,
                                        "default": 128
                                    },
                                    "Green": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 255,
                                        "default": 128
                                    },
                                    "Blue": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 255,
                                        "default": 128
                                    }
                                }
                            },
                            "AgentName": {
                                "type": "string",
                                "description": "Agent 名称",
                                "minLength": 1
                            },
                            "AgentDescription": {
                                "type": "string",
                                "description": "Agent 功能描述（人类可读）"
                            },
                            "AgentShortDescription": {
                                "type": "string",
                                "description": "Agent 简短描述（AI 激活用）",
                                "default": "A default subagent"
                            },
                            "AgentPrompt": {
                                "type": "string",
                                "description": "Agent 系统提示词"
                            },
                            "AgentModel": {
                                "type": "integer",
                                "description": "Agent 使用的模型ID，引用 Model.Models 中的键"
                            },
                            "AutoApprove": {
                                "type": "string",
                                "description": "expr-lang 表达式，满足条件时自动批准操作",
                                "default": ""
                            },
                            "AutoReject": {
                                "type": "string",
                                "description": "expr-lang 表达式，满足条件时自动拒绝操作",
                                "default": ""
                            },
                            "DisableSandbox": {
                                "type": "boolean",
                                "description": "禁用 sandbox 执行",
                                "default": false
                            }
                        }
                    }
                },
                "GlobalPrompt": {
                    "type": "string",
                    "description": "全局系统提示词，会附加到所有对话中",
                    "default": ""
                },
                "SummaryModel": {
                    "type": "integer",
                    "description": "用于对话摘要的模型ID"
                },
                "MaxCallCount": {
                    "type": "integer",
                    "description": "单次会话最大调用次数",
                    "minimum": 1,
                    "default": 50
                },
                "AutoApprove": {
                    "type": "string",
                    "description": "全局 expr-lang 自动批准表达式",
                    "default": ""
                },
                "AutoReject": {
                    "type": "string",
                    "description": "全局 expr-lang 自动拒绝表达式",
                    "default": ""
                },
                "IgnoreBuiltinAgents": {
                    "type": "boolean",
                    "description": "忽略内置 Agent 定义",
                    "default": false
                },
                "IgnoreDefaultRules": {
                    "type": "boolean",
                    "description": "忽略默认自动审批/拒绝规则",
                    "default": false
                },
                "DisablePromptPreprocess": {
                    "type": "boolean",
                    "description": "禁用提示词预处理（Prompt 分类器）",
                    "default": false
                },
                "UseShell": {
                    "type": "string",
                    "description": "默认使用的 Shell",
                    "default": ""
                },
                "TerminalEnvs": {
                    "type": "object",
                    "description": "终端启动时注入的环境变量",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "default": {}
                },
                "DisableSandbox": {
                    "type": "boolean",
                    "description": "全局禁用 Sandbox 执行",
                    "default": false
                }
            }
        },
        "ThemeID": {
            "type": "integer",
            "description": "UI 主题ID",
            "default": 0
        },
        "Server": {
            "type": "object",
            "description": "服务器配置",
            "required": [
                "Key"
            ],
            "properties": {
                "Key": {
                    "type": "string",
                    "description": "WebSocket 通信密钥"
                },
                "Path": {
                    "type": "string",
                    "description": "WebSocket 路径",
                    "pattern": "^/",
                    "default": "/acp"
                },
                "Host": {
                    "type": "string",
                    "description": "监听地址",
                    "default": "127.0.0.1"
                },
                "Port": {
                    "type": "integer",
                    "description": "监听端口",
                    "minimum": 1,
                    "maximum": 65535,
                    "default": 7433
                },
                "DisableStdioServer": {
                    "type": "boolean",
                    "description": "是否禁用 Stdio 服务器模式",
                    "default": false
                },
                "SessionTimeout": {
                    "type": "integer",
                    "description": "连接断开后等待客户端重连的超时时间（秒）",
                    "minimum": 1,
                    "maximum": 86400,
                    "default": 60
                }
            }
        },
        "Context": {
            "type": "object",
            "description": "上下文/集成相关配置",
            "properties": {
                "LSP": {
                    "type": "object",
                    "description": "LSP 客户端配置",
                    "properties": {
                        "Enabled": {
                            "type": "boolean",
                            "description": "是否启用 LSP 客户端",
                            "default": false
                        },
                        "LanguageServers": {
                            "type": "object",
                            "description": "自定义语言服务器映射，key 为文件扩展名（如 \".go\"）",
                            "additionalProperties": {
                                "type": "object",
                                "required": [
                                    "Command"
                                ],
                                "properties": {
                                    "Command": {
                                        "type": "string",
                                        "description": "可执行文件路径或命令名"
                                    },
                                    "Args": {
                                        "type": "array",
                                        "description": "命令行参数",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "IdleTimeout": {
                            "type": "integer",
                            "description": "空闲超时秒数，超过此时间未使用的 LSP 进程将被回收",
                            "minimum": 1,
                            "default": 600
                        }
                    }
                },
                "EmbeddingModelID": {
                    "type": "integer",
                    "description": "嵌入模型在 Models 映射中的 key",
                    "default": 1
                },
                "OnlineSearch": {
                    "type": "object",
                    "description": "在线搜索配置项"
                },
                "Codebase": {
                    "type": "object",
                    "description": "代码库搜索引擎参数调优",
                    "properties": {
                        "BM25Weight": {
                            "type": "number",
                            "description": "BM25 搜索权重（0~1），向量搜索权重为 1-BM25Weight",
                            "minimum": 0,
                            "maximum": 1,
                            "default": 0.7
                        },
                        "VectorMinSimilarity": {
                            "type": "number",
                            "description": "向量最小余弦相似度保留阈值（0~1）",
                            "minimum": 0,
                            "maximum": 1,
                            "default": 0.5
                        },
                        "BM25RetentionScore": {
                            "type": "number",
                            "description": "BM25 保留阈值，高于此值的项被丢弃（0 表示不限）",
                            "minimum": 0,
                            "default": 0.0
                        }
                    }
                }
            }
        },
        "ignoreSignals": {
            "type": "boolean",
            "description": "为 true 时忽略 SIGTERM/SIGINT/SIGQUIT 信号，进程不会因这些信号退出",
            "default": false
        }
    }
}