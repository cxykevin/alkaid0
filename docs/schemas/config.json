{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "alkaid0 Config",
    "description": "alkaid0 配置文件",
    "type": "object",
    "required": [
        "Version",
        "Model",
        "Agent",
        "ThemeID",
        "Server"
    ],
    "properties": {
        "Version": {
            "type": "integer",
            "description": "配置版本号",
            "minimum": 1,
            "default": 1
        },
        "Model": {
            "type": "object",
            "description": "模型相关配置",
            "required": [
                "DefaultModelID",
                "Models"
            ],
            "properties": {
                "ProviderURL": {
                    "type": "string",
                    "description": "默认供应商URL（备用字段）",
                    "format": "uri"
                },
                "ProviderKey": {
                    "type": "string",
                    "description": "默认供应商密钥（备用字段）"
                },
                "DefaultModelID": {
                    "type": "integer",
                    "description": "默认使用的模型ID，对应 Models 中的键"
                },
                "Models": {
                    "type": "object",
                    "description": "模型定义集合，键为模型ID（整数字符串）",
                    "additionalProperties": {
                        "type": "object",
                        "required": [
                            "ModelName",
                            "ModelID"
                        ],
                        "properties": {
                            "ModelName": {
                                "type": "string",
                                "description": "模型显示名称",
                                "minLength": 1
                            },
                            "ModelID": {
                                "type": "string",
                                "description": "模型在供应商处的ID"
                            },
                            "ModelDescription": {
                                "type": "string",
                                "description": "模型描述",
                                "default": ""
                            },
                            "ModelAddPrompt": {
                                "type": "string",
                                "description": "附加的系统提示词",
                                "default": ""
                            },
                            "ModelTopP": {
                                "type": "number",
                                "description": "Top-P 采样参数，-1 代表使用供应商默认值",
                                "default": -1
                            },
                            "ModelTopK": {
                                "type": "number",
                                "description": "Top-K 采样参数，-1 代表使用供应商默认值",
                                "default": -1
                            },
                            "ModelTemperature": {
                                "type": "number",
                                "description": "温度参数，-1 代表使用供应商默认值",
                                "default": -1
                            },
                            "TokenLimit": {
                                "type": "integer",
                                "description": "单次请求最大 Token 数",
                                "minimum": 1,
                                "default": 8192
                            },
                            "ProviderURL": {
                                "type": "string",
                                "description": "模型供应商API地址（覆写全局值）",
                                "format": "uri"
                            },
                            "ProviderKey": {
                                "type": "string",
                                "description": "模型供应商API密钥（覆写全局值）"
                            },
                            "EnableThinking": {
                                "type": "boolean",
                                "description": "是否启用思考模式",
                                "default": false
                            },
                            "EnableToolCalling": {
                                "type": "boolean",
                                "description": "是否启用工具调用（只影响 delta 拼接）",
                                "default": false
                            },
                            "CompressSize": {
                                "type": "integer",
                                "description": "上下文压缩阈值（token数）",
                                "minimum": 0,
                                "default": 128000
                            },
                            "Hide": {
                                "type": "boolean",
                                "description": "是否在列表中隐藏",
                                "default": false
                            },
                            "Type": {
                                "type": "string",
                                "description": "模型类型：\"\"(LLM)、\"embedding\"、\"rerank\"",
                                "enum": [
                                    "",
                                    "embedding",
                                    "rerank"
                                ],
                                "default": ""
                            },
                            "CachePriceMultiplier": {
                                "type": "number",
                                "description": "缓存命中 token 相对输入价格的倍率（用于 trace 保留/破坏缓存成本决策）",
                                "minimum": 0,
                                "default": 0.2
                            },
                            "CacheRetentionMinutes": {
                                "type": "integer",
                                "description": "缓存保留时间（分钟），从会话最后活动时间起算，超过则强制清除 trace",
                                "minimum": 0,
                                "default": 180
                            },
                            "ProviderSpecificConfig": {
                                "type": "object",
                                "description": "供应商特定功能开关（可选，省略时使用以下默认值）",
                                "properties": {
                                    "EnableDeepseekThinking": {
                                        "type": "boolean",
                                        "default": false
                                    },
                                    "EnableReasoningEffort": {
                                        "type": "boolean",
                                        "default": true
                                    },
                                    "EnableTopP": {
                                        "type": "boolean",
                                        "default": false
                                    },
                                    "EnableTopK": {
                                        "type": "boolean",
                                        "default": false
                                    },
                                    "EnableTemperature": {
                                        "type": "boolean",
                                        "default": false
                                    },
                                    "EnableUsage": {
                                        "type": "boolean",
                                        "default": true
                                    },
                                    "Dimension": {
                                        "type": "integer",
                                        "description": "嵌入模型向量维度（嵌入模型必填）",
                                        "minimum": 0,
                                        "default": 0
                                    },
                                    "ToolPromptEnhance": {
                                        "type": "string",
                                        "description": "工具调用反幻觉增强提示词开关：auto(默认,启用；模型id命中 gpt/sol/luna/terra/claude/fable/sonnet/haiku/opus 时自动免增强) / on(强制启用) / off(强制关闭)",
                                        "enum": ["auto", "on", "off"],
                                        "default": "auto"
                                    },
                                    "EnableToolCallingCompat": {
                                        "type": "boolean",
                                        "description": "历史回放兼容模式：把\"一个 assistant 携带多个 tool_calls\"的消息拆分为逐条\"单 tool_call + 结果\"，适配逐条转换 role:tool 消息的 OpenAI→Anthropic 代理（默认关闭）",
                                        "default": false
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "Agent": {
            "type": "object",
            "description": "Agent 系统配置",
            "properties": {
                "Agents": {
                    "type": "object",
                    "description": "Agent 定义集合",
                    "additionalProperties": {
                        "type": "object",
                        "required": [
                            "AgentName",
                            "AgentDescription",
                            "AgentPrompt",
                            "AgentModel"
                        ],
                        "properties": {
                            "Color": {
                                "type": "object",
                                "description": "Agent 颜色（RGB）",
                                "properties": {
                                    "Red": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 255,
                                        "default": 128
                                    },
                                    "Green": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 255,
                                        "default": 128
                                    },
                                    "Blue": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 255,
                                        "default": 128
                                    }
                                }
                            },
                            "AgentName": {
                                "type": "string",
                                "description": "Agent 名称",
                                "minLength": 1
                            },
                            "AgentDescription": {
                                "type": "string",
                                "description": "Agent 功能描述（人类可读）"
                            },
                            "AgentShortDescription": {
                                "type": "string",
                                "description": "Agent 简短描述（AI 激活用）",
                                "default": "A default subagent"
                            },
                            "AgentPrompt": {
                                "type": "string",
                                "description": "Agent 系统提示词"
                            },
                            "AgentModel": {
                                "type": "integer",
                                "description": "Agent 使用的模型ID，引用 Model.Models 中的键"
                            },
                            "AutoApprove": {
                                "type": "string",
                                "description": "expr-lang 表达式，满足条件时自动批准操作",
                                "default": ""
                            },
                            "AutoReject": {
                                "type": "string",
                                "description": "expr-lang 表达式，满足条件时自动拒绝操作",
                                "default": ""
                            },
                            "DisableSandbox": {
                                "type": "boolean",
                                "description": "禁用 sandbox 执行",
                                "default": false
                            }
                        }
                    }
                },
                "GlobalPrompt": {
                    "type": "string",
                    "description": "全局系统提示词，会附加到所有对话中",
                    "default": ""
                },
                "SummaryModel": {
                    "type": "integer",
                    "description": "用于对话摘要的模型ID"
                },
                "TitleModel": {
                    "type": "integer",
                    "description": "用于生成会话标题的模型ID，未设置或为 0 时回退到 Model.DefaultModelID"
                },
                "MaxCallCount": {
                    "type": "integer",
                    "description": "单次会话最大调用次数",
                    "minimum": 1,
                    "default": 50
                },
                "AutoApprove": {
                    "type": "string",
                    "description": "全局 expr-lang 自动批准表达式",
                    "default": ""
                },
                "AutoReject": {
                    "type": "string",
                    "description": "全局 expr-lang 自动拒绝表达式",
                    "default": ""
                },
                "IgnoreBuiltinAgents": {
                    "type": "boolean",
                    "description": "忽略内置 Agent 定义",
                    "default": false
                },
                "IgnoreDefaultRules": {
                    "type": "boolean",
                    "description": "忽略默认自动审批/拒绝规则",
                    "default": false
                },
                "DisablePromptPreprocess": {
                    "type": "boolean",
                    "description": "禁用提示词预处理（Prompt 分类器）",
                    "default": false
                },
                "UseShell": {
                    "type": "string",
                    "description": "默认使用的 Shell",
                    "default": ""
                },
                "FetchProxy": {
                    "type": "string",
                    "description": "fetch 工具的全局 HTTP 代理地址（支持 http/https/socks5），空为直连；hidden 伪装模式下同样生效",
                    "default": ""
                },
                "TerminalEnvs": {
                    "type": "object",
                    "description": "终端启动时注入的环境变量",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "default": {}
                },
                "DisableSandbox": {
                    "type": "boolean",
                    "description": "全局禁用 Sandbox 执行",
                    "default": false
                }
            }
        },
        "ThemeID": {
            "type": "integer",
            "description": "UI 主题ID",
            "default": 0
        },
        "Server": {
            "type": "object",
            "description": "服务器配置",
            "required": [
                "Key"
            ],
            "properties": {
                "Key": {
                    "type": "string",
                    "description": "WebSocket 通信密钥"
                },
                "Path": {
                    "type": "string",
                    "description": "WebSocket 路径",
                    "pattern": "^/",
                    "default": "/acp"
                },
                "Host": {
                    "type": "string",
                    "description": "监听地址",
                    "default": "127.0.0.1"
                },
                "Port": {
                    "type": "integer",
                    "description": "监听端口",
                    "minimum": 1,
                    "maximum": 65535,
                    "default": 7433
                },
                "DisableStdioServer": {
                    "type": "boolean",
                    "description": "是否禁用 Stdio 服务器模式",
                    "default": false
                },
                "SessionTimeout": {
                    "type": "integer",
                    "description": "连接断开后等待客户端重连的超时时间（秒）",
                    "minimum": 1,
                    "maximum": 86400,
                    "default": 60
                }
            }
        },
        "Context": {
            "type": "object",
            "description": "上下文/集成相关配置",
            "properties": {
                "LSP": {
                    "type": "object",
                    "description": "LSP 客户端配置",
                    "properties": {
                        "Enabled": {
                            "type": "boolean",
                            "description": "是否启用 LSP 客户端",
                            "default": false
                        },
                        "LanguageServers": {
                            "type": "object",
                            "description": "自定义语言服务器映射，key 为文件扩展名（如 \".go\"）",
                            "additionalProperties": {
                                "type": "object",
                                "required": [
                                    "Command"
                                ],
                                "properties": {
                                    "Command": {
                                        "type": "string",
                                        "description": "可执行文件路径或命令名"
                                    },
                                    "Args": {
                                        "type": "array",
                                        "description": "命令行参数",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "IdleTimeout": {
                            "type": "integer",
                            "description": "空闲超时秒数，超过此时间未使用的 LSP 进程将被回收",
                            "minimum": 1,
                            "default": 600
                        }
                    }
                },
                "EmbeddingModelID": {
                    "type": "integer",
                    "description": "嵌入模型在 Models 映射中的 key",
                    "default": 1
                },
                "OnlineSearch": {
                    "type": "object",
                    "description": "在线搜索配置项（alkaid0-search-engine）。全部 provider 默认关闭，仅 Bing 默认启用（无需密钥）。search 工具 online=true 时可通过 path 参数用 provider id（bing/github/arxiv/tavily/context7/zread/brave/grepapp/sourcegraph/stackoverflow/hackernews/devto/librariesio）限定搜索源",
                    "properties": {
                        "timeout": {
                            "type": "integer",
                            "description": "请求超时（秒）",
                            "minimum": 1,
                            "default": 30
                        },
                        "proxy_url": {
                            "type": "string",
                            "description": "HTTP 代理地址，支持 http/https/socks5，为空不使用代理",
                            "default": ""
                        },
                        "retry_count": {
                            "type": "integer",
                            "description": "请求重试次数",
                            "minimum": 0,
                            "default": 3
                        },
                        "bing": {
                            "type": "object",
                            "description": "Bing 搜索（SERP 抓取，无需密钥，utls 反指纹绕过 Cloudflare），默认启用",
                            "properties": {
                                "enable": {
                                    "type": "boolean",
                                    "description": "是否启用该搜索源",
                                    "default": true
                                },
                                "user_agent": {
                                    "type": "string",
                                    "description": "浏览器 User-Agent",
                                    "default": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36"
                                },
                                "proxy_url": {
                                    "type": "string",
                                    "description": "代理地址，为空时降级到全局 proxy_url"
                                },
                                "min_delay": {
                                    "type": "integer",
                                    "description": "请求最小间隔（秒）",
                                    "minimum": 0,
                                    "default": 2
                                },
                                "max_delay": {
                                    "type": "integer",
                                    "description": "请求最大间隔（秒）",
                                    "minimum": 0,
                                    "default": 5
                                },
                                "market": {
                                    "type": "string",
                                    "description": "市场代码，如 \"en-US\"、\"zh-CN\""
                                },
                                "set_lang": {
                                    "type": "string",
                                    "description": "UI 语言，如 \"en-US\"、\"zh-Hans\""
                                },
                                "country": {
                                    "type": "string",
                                    "description": "国家代码，如 \"US\"、\"CN\""
                                },
                                "safe_search": {
                                    "type": "string",
                                    "description": "安全搜索级别",
                                    "enum": ["Off", "Moderate", "Strict"]
                                },
                                "freshness": {
                                    "type": "string",
                                    "description": "时间筛选",
                                    "enum": ["Day", "Week", "Month"]
                                },
                                "max_results": {
                                    "type": "integer",
                                    "description": "最大返回结果数（0 表示不限制）",
                                    "minimum": 0,
                                    "default": 10
                                }
                            }
                        },
                        "github": {
                            "type": "object",
                            "description": "GitHub 搜索（REST API v3，需 Personal Access Token），默认关闭",
                            "properties": {
                                "enable": {
                                    "type": "boolean",
                                    "description": "是否启用该搜索源",
                                    "default": false
                                },
                                "token": {
                                    "type": "string",
                                    "description": "GitHub personal access token"
                                },
                                "proxy_url": {
                                    "type": "string",
                                    "description": "代理地址，为空时降级到全局 proxy_url"
                                },
                                "max_results": {
                                    "type": "integer",
                                    "description": "每页最大结果数（1-100，0 表示不限制）",
                                    "minimum": 0,
                                    "default": 5
                                }
                            }
                        },
                        "arxiv": {
                            "type": "object",
                            "description": "arXiv 学术论文搜索（无需密钥），默认关闭",
                            "properties": {
                                "enable": {
                                    "type": "boolean",
                                    "description": "是否启用该搜索源",
                                    "default": false
                                },
                                "proxy_url": {
                                    "type": "string",
                                    "description": "代理地址，为空时降级到全局 proxy_url"
                                },
                                "max_results": {
                                    "type": "integer",
                                    "description": "最大返回结果数（0 表示使用 API 默认值 10）",
                                    "minimum": 0,
                                    "default": 5
                                }
                            }
                        },
                        "tavily": {
                            "type": "object",
                            "description": "Tavily 通用 web 搜索（REST API，需 API Key），默认关闭",
                            "properties": {
                                "enable": {
                                    "type": "boolean",
                                    "description": "是否启用该搜索源",
                                    "default": false
                                },
                                "api_key": {
                                    "type": "string",
                                    "description": "Tavily API key"
                                },
                                "proxy_url": {
                                    "type": "string",
                                    "description": "代理地址，为空时降级到全局 proxy_url"
                                },
                                "search_depth": {
                                    "type": "string",
                                    "description": "搜索深度",
                                    "enum": ["basic", "advanced"],
                                    "default": "basic"
                                },
                                "max_results": {
                                    "type": "integer",
                                    "description": "最大结果数",
                                    "minimum": 0,
                                    "default": 10
                                },
                                "include_answer": {
                                    "type": "boolean",
                                    "description": "是否包含 AI 摘要回答",
                                    "default": false
                                },
                                "include_raw_content": {
                                    "type": "boolean",
                                    "description": "是否包含原始内容",
                                    "default": false
                                }
                            }
                        },
                        "context7": {
                            "type": "object",
                            "description": "Context7 库/文档搜索（context7.com，API Key 选填，缺失时使用低速率限制），默认关闭",
                            "properties": {
                                "enable": {
                                    "type": "boolean",
                                    "description": "是否启用该搜索源",
                                    "default": false
                                },
                                "api_key": {
                                    "type": "string",
                                    "description": "Context7 API key（选填）"
                                },
                                "proxy_url": {
                                    "type": "string",
                                    "description": "代理地址，为空时降级到全局 proxy_url"
                                },
                                "fast": {
                                    "type": "boolean",
                                    "description": "是否跳过 LLM 重排（true 更快但相关性略降）",
                                    "default": false
                                },
                                "max_results": {
                                    "type": "integer",
                                    "description": "最大返回结果数（0 表示使用 API 默认值）",
                                    "minimum": 0,
                                    "default": 0
                                }
                            }
                        },
                        "zread": {
                            "type": "object",
                            "description": "Zread AI GitHub 仓库助手（zread.ai，无需密钥，utls + HTTP/2），默认关闭",
                            "properties": {
                                "enable": {
                                    "type": "boolean",
                                    "description": "是否启用该搜索源",
                                    "default": false
                                },
                                "proxy_url": {
                                    "type": "string",
                                    "description": "代理地址，为空时降级到全局 proxy_url"
                                },
                                "locale": {
                                    "type": "string",
                                    "description": "结果描述语言",
                                    "enum": ["zh", "en"],
                                    "default": "zh"
                                },
                                "user_agent": {
                                    "type": "string",
                                    "description": "浏览器 User-Agent",
                                    "default": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36"
                                },
                                "min_delay": {
                                    "type": "integer",
                                    "description": "请求最小间隔（秒）",
                                    "minimum": 0,
                                    "default": 2
                                },
                                "max_delay": {
                                    "type": "integer",
                                    "description": "请求最大间隔（秒）",
                                    "minimum": 0,
                                    "default": 5
                                },
                                "max_results": {
                                    "type": "integer",
                                    "description": "最大返回结果数（0 表示不限制）",
                                    "minimum": 0,
                                    "default": 0
                                }
                            }
                        },
                        "brave": {
                            "type": "object",
                            "description": "Brave Search（api.search.brave.com，独立索引通用 web 搜索，需 API Key），默认关闭",
                            "properties": {
                                "enable": {
                                    "type": "boolean",
                                    "description": "是否启用该搜索源",
                                    "default": false
                                },
                                "api_key": {
                                    "type": "string",
                                    "description": "Brave Search API 订阅令牌"
                                },
                                "proxy_url": {
                                    "type": "string",
                                    "description": "代理地址，为空时降级到全局 proxy_url"
                                },
                                "country": {
                                    "type": "string",
                                    "description": "2 字母国家码",
                                    "default": "US"
                                },
                                "search_lang": {
                                    "type": "string",
                                    "description": "搜索内容语言",
                                    "default": "en"
                                },
                                "ui_lang": {
                                    "type": "string",
                                    "description": "响应元数据语言",
                                    "default": "en-US"
                                },
                                "safesearch": {
                                    "type": "string",
                                    "description": "安全搜索级别",
